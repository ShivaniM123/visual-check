{
  "manifest_version": 3,
  "name": "Parity Check for AEM",
  "short_name": "Parity Check",
  "version": "1.0.0",
  "description": "Compare the page you have open with its original page: visual parity issues pinned on the page, plus a Lighthouse comparison from Google PageSpeed Insights.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Parity Check: compare this page with the original",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": ["sidePanel", "scripting", "tabs", "storage"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Open Parity Check"
    }
  }
}
